# GEMINI_API_KEY: Optional key for server-side Gemini features
GEMINI_API_KEY=

# APP_URL: Public URL of the applet
APP_URL=http://localhost:3000

# Cloudflare Turnstile keys
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Admin Authentication Secret
ADMIN_SECRET_KEY=sipario_admin_secret_key_2026

# SMTP Email Settings per invio email reali ai clienti (es. Gmail, Sendgrid)
# Se non configurati, le email verranno simulate nella console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua_email@gmail.com
SMTP_PASS=tua_password_app
SMTP_FROM="Teatro Sipario <tua_email@gmail.com>"
